{
  "name": "thebrain-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for TheBrain 15 — semantic operations over the local API",
  "type": "module",
  "license": "MIT",
  "author": "yBookoff <12408023+yBookoff@users.noreply.github.com>",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "thebrain",
    "knowledge-graph",
    "pkm",
    "second-brain",
    "semantic-search",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yBookoff/thebrain-mcp.git"
  },
  "homepage": "https://github.com/yBookoff/thebrain-mcp#readme",
  "bugs": {
    "url": "https://github.com/yBookoff/thebrain-mcp/issues"
  },
